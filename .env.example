# The API scaffold needs no provider credentials.
STRUCTAGENT_ENVIRONMENT=local
STRUCTAGENT_LOG_LEVEL=INFO

# Optional provider smoke credentials. Neither value is sent into the Daytona sandbox.
DAYTONA_API_KEY=
OPENAI_API_KEY=

# Low-cost defaults for live smoke tests; override only when testing another model.
OPENAI_SMOKE_MODEL=gpt-5.6-luna
CODEX_SMOKE_MODEL=gpt-5.6-luna
