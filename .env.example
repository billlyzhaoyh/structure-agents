STRUCTAGENT_ENVIRONMENT=local
STRUCTAGENT_LOG_LEVEL=INFO

# Required by opt-in Daytona commands and the synthetic frontend launch route.
DAYTONA_API_KEY=

# Required only by opt-in natural-language task compilation.
OPENAI_API_KEY=
STRUCTAGENT_OPENAI_MODEL=gpt-5.6-terra

# Prefer MODAL_PROFILE locally. Headless controllers may instead provide the token pair.
MODAL_PROFILE=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Keep disabled unless the approved private H&M live run is intentional.
STRUCTAGENT_ALLOW_REAL_HM=0
STRUCTAGENT_ALLOW_RTJ_MODAL=0

# Local hack-demo bridge for one paid 32-customer user-churn run. Keep disabled in deployments.
STRUCTAGENT_ENABLE_MODAL_UI=0
# STRUCTAGENT_RTJ_DATASET_ROOT=/absolute/path/to/rel-hm/db
# STRUCTAGENT_RTJ_MATERIALIZATION_ROOT=/absolute/path/to/tasks/user-churn
STRUCTAGENT_RTJ_OUTPUT_ROOT=.artifacts/ui-rtj
STRUCTAGENT_RTJ_MODAL_GPU=L4
