STRUCTAGENT_ENVIRONMENT=local
STRUCTAGENT_LOG_LEVEL=INFO

# Required by opt-in Daytona commands and the synthetic frontend launch route.
DAYTONA_API_KEY=

# Required by opt-in natural-language task compilation and by the opt-in
# simulation respondent boundary, which mounts it into Daytona as a scoped secret.
OPENAI_API_KEY=
STRUCTAGENT_OPENAI_MODEL=gpt-5.6-terra

# Prefer MODAL_PROFILE locally. Headless controllers may instead provide the token pair.
MODAL_PROFILE=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Keep disabled unless the approved private H&M live run is intentional.
STRUCTAGENT_ALLOW_REAL_HM=0
STRUCTAGENT_ALLOW_RTJ_MODAL=0
