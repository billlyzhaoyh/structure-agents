{
  "$defs": {
    "ColumnDescriptor": {
      "additionalProperties": false,
      "properties": {
        "data_type": {
          "enum": [
            "boolean",
            "categorical",
            "integer",
            "number",
            "string",
            "text",
            "timestamp"
          ],
          "title": "Data Type",
          "type": "string"
        },
        "foreign_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForeignKeyReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "primary_key": {
          "default": false,
          "title": "Primary Key",
          "type": "boolean"
        },
        "time_column": {
          "default": false,
          "title": "Time Column",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "data_type"
      ],
      "title": "ColumnDescriptor",
      "type": "object"
    },
    "ForeignKeyReference": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "table",
        "column"
      ],
      "title": "ForeignKeyReference",
      "type": "object"
    },
    "TableDescriptor": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnDescriptor"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "columns"
      ],
      "title": "TableDescriptor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "v1",
      "title": "Contract Version",
      "type": "string"
    },
    "dataset_id": {
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "display_name": {
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "fixture": {
      "const": true,
      "title": "Fixture",
      "type": "boolean"
    },
    "implementation_status": {
      "const": "metadata_only",
      "title": "Implementation Status",
      "type": "string"
    },
    "supported_task_types": {
      "items": {
        "enum": [
          "binary_classification",
          "regression"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Task Types",
      "type": "array"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/TableDescriptor"
      },
      "minItems": 1,
      "title": "Tables",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "fixture",
    "implementation_status",
    "dataset_id",
    "display_name",
    "description",
    "supported_task_types",
    "tables"
  ],
  "title": "DatasetDescriptor",
  "type": "object"
}
