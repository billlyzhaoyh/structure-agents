{
  "$defs": {
    "BinaryTaskContract": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "draft_id": {
          "minLength": 1,
          "title": "Draft Id",
          "type": "string"
        },
        "eligibility_definition": {
          "minLength": 1,
          "title": "Eligibility Definition",
          "type": "string"
        },
        "entity": {
          "$ref": "#/$defs/EntitySpec"
        },
        "horizon": {
          "$ref": "#/$defs/HorizonSpec"
        },
        "label_definition": {
          "minLength": 1,
          "title": "Label Definition",
          "type": "string"
        },
        "prediction_time": {
          "$ref": "#/$defs/PredictionTimeSpec"
        },
        "query_artifacts": {
          "items": {
            "$ref": "#/$defs/QueryArtifact"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Query Artifacts",
          "type": "array"
        },
        "recommended_metrics": {
          "items": {
            "enum": [
              "accuracy",
              "auroc",
              "average_precision",
              "brier_score",
              "f1",
              "log_loss"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Recommended Metrics",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/TargetSpec"
        },
        "task_type": {
          "const": "binary_classification",
          "title": "Task Type",
          "type": "string"
        }
      },
      "required": [
        "draft_id",
        "dataset_id",
        "entity",
        "prediction_time",
        "horizon",
        "target",
        "eligibility_definition",
        "label_definition",
        "query_artifacts",
        "task_type",
        "recommended_metrics"
      ],
      "title": "BinaryTaskContract",
      "type": "object"
    },
    "ClarificationQuestion": {
      "additionalProperties": false,
      "properties": {
        "answer_kind": {
          "enum": [
            "free_text",
            "single_choice"
          ],
          "title": "Answer Kind",
          "type": "string"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "question_id": {
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "prompt",
        "answer_kind"
      ],
      "title": "ClarificationQuestion",
      "type": "object"
    },
    "DraftReady": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "discriminator": {
            "mapping": {
              "binary_classification": "#/$defs/BinaryTaskContract",
              "regression": "#/$defs/RegressionTaskContract"
            },
            "propertyName": "task_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BinaryTaskContract"
            },
            {
              "$ref": "#/$defs/RegressionTaskContract"
            }
          ],
          "title": "Contract"
        },
        "contract_version": {
          "const": "v1",
          "title": "Contract Version",
          "type": "string"
        },
        "fixture": {
          "const": true,
          "title": "Fixture",
          "type": "boolean"
        },
        "implementation_status": {
          "const": "placeholder",
          "title": "Implementation Status",
          "type": "string"
        },
        "outcome": {
          "const": "draft_ready",
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "fixture",
        "implementation_status",
        "outcome",
        "contract"
      ],
      "title": "DraftReady",
      "type": "object"
    },
    "EntitySpec": {
      "additionalProperties": false,
      "properties": {
        "key_column": {
          "minLength": 1,
          "title": "Key Column",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "table",
        "key_column"
      ],
      "title": "EntitySpec",
      "type": "object"
    },
    "HorizonSpec": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "days",
            "weeks",
            "months"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "HorizonSpec",
      "type": "object"
    },
    "NeedsClarification": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "v1",
          "title": "Contract Version",
          "type": "string"
        },
        "draft_id": {
          "minLength": 1,
          "title": "Draft Id",
          "type": "string"
        },
        "fixture": {
          "const": true,
          "title": "Fixture",
          "type": "boolean"
        },
        "implementation_status": {
          "const": "placeholder",
          "title": "Implementation Status",
          "type": "string"
        },
        "outcome": {
          "const": "needs_clarification",
          "title": "Outcome",
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/ClarificationQuestion"
          },
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "contract_version",
        "fixture",
        "implementation_status",
        "outcome",
        "draft_id",
        "questions"
      ],
      "title": "NeedsClarification",
      "type": "object"
    },
    "PredictionTimeSpec": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "table",
        "column"
      ],
      "title": "PredictionTimeSpec",
      "type": "object"
    },
    "QueryArtifact": {
      "additionalProperties": false,
      "properties": {
        "dialect": {
          "const": "duckdb",
          "title": "Dialect",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "eligibility",
            "label"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "sql": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sql"
        },
        "status": {
          "enum": [
            "generated",
            "not_generated"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "status",
        "dialect",
        "sql"
      ],
      "title": "QueryArtifact",
      "type": "object"
    },
    "RegressionTaskContract": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "draft_id": {
          "minLength": 1,
          "title": "Draft Id",
          "type": "string"
        },
        "eligibility_definition": {
          "minLength": 1,
          "title": "Eligibility Definition",
          "type": "string"
        },
        "entity": {
          "$ref": "#/$defs/EntitySpec"
        },
        "horizon": {
          "$ref": "#/$defs/HorizonSpec"
        },
        "label_definition": {
          "minLength": 1,
          "title": "Label Definition",
          "type": "string"
        },
        "prediction_time": {
          "$ref": "#/$defs/PredictionTimeSpec"
        },
        "query_artifacts": {
          "items": {
            "$ref": "#/$defs/QueryArtifact"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Query Artifacts",
          "type": "array"
        },
        "recommended_metrics": {
          "items": {
            "enum": [
              "mae",
              "r2",
              "rmse"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Recommended Metrics",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/TargetSpec"
        },
        "task_type": {
          "const": "regression",
          "title": "Task Type",
          "type": "string"
        }
      },
      "required": [
        "draft_id",
        "dataset_id",
        "entity",
        "prediction_time",
        "horizon",
        "target",
        "eligibility_definition",
        "label_definition",
        "query_artifacts",
        "task_type",
        "recommended_metrics"
      ],
      "title": "RegressionTaskContract",
      "type": "object"
    },
    "TargetSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "positive_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positive Class"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "TargetSpec",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "draft_ready": "#/$defs/DraftReady",
      "needs_clarification": "#/$defs/NeedsClarification"
    },
    "propertyName": "outcome"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/NeedsClarification"
    },
    {
      "$ref": "#/$defs/DraftReady"
    }
  ]
}
