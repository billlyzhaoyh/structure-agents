{
  "$defs": {
    "BinaryTaskContract": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "draft_id": {
          "minLength": 1,
          "title": "Draft Id",
          "type": "string"
        },
        "eligibility_definition": {
          "minLength": 1,
          "title": "Eligibility Definition",
          "type": "string"
        },
        "entity": {
          "$ref": "#/$defs/EntitySpec"
        },
        "horizon": {
          "$ref": "#/$defs/HorizonSpec"
        },
        "label_definition": {
          "minLength": 1,
          "title": "Label Definition",
          "type": "string"
        },
        "prediction_time": {
          "$ref": "#/$defs/PredictionTimeSpec"
        },
        "query_artifacts": {
          "items": {
            "$ref": "#/$defs/QueryArtifact"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Query Artifacts",
          "type": "array"
        },
        "recommended_metrics": {
          "items": {
            "enum": [
              "accuracy",
              "auroc",
              "average_precision",
              "brier_score",
              "f1",
              "log_loss"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Recommended Metrics",
          "type": "array"
        },
        "source": {
          "const": "custom",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetSpec"
        },
        "task_type": {
          "const": "binary_classification",
          "title": "Task Type",
          "type": "string"
        }
      },
      "required": [
        "source",
        "draft_id",
        "dataset_id",
        "entity",
        "prediction_time",
        "horizon",
        "target",
        "eligibility_definition",
        "label_definition",
        "query_artifacts",
        "task_type",
        "recommended_metrics"
      ],
      "title": "BinaryTaskContract",
      "type": "object"
    },
    "BinaryValidationEvidence": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Columns",
          "type": "array"
        },
        "null_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Null Rate",
          "type": "number"
        },
        "positive_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Positive Rate",
          "type": "number"
        },
        "query_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Query Sha256",
          "type": "string"
        },
        "row_count": {
          "exclusiveMinimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "task_type": {
          "const": "binary_classification",
          "title": "Task Type",
          "type": "string"
        }
      },
      "required": [
        "task_type",
        "query_sha256",
        "columns",
        "row_count",
        "null_rate",
        "positive_rate"
      ],
      "title": "BinaryValidationEvidence",
      "type": "object"
    },
    "ClarificationQuestion": {
      "additionalProperties": false,
      "properties": {
        "answer_kind": {
          "enum": [
            "free_text",
            "single_choice"
          ],
          "title": "Answer Kind",
          "type": "string"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "question_id": {
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "prompt",
        "answer_kind"
      ],
      "title": "ClarificationQuestion",
      "type": "object"
    },
    "CompilerProvenance": {
      "additionalProperties": false,
      "description": "Non-sensitive provenance for one agent-compiled query.",
      "properties": {
        "attempt_count": {
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt Count",
          "type": "integer"
        },
        "instructions_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Instructions Sha256",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Sha256",
          "type": "string"
        }
      },
      "required": [
        "model",
        "prompt_sha256",
        "schema_sha256",
        "instructions_sha256",
        "attempt_count"
      ],
      "title": "CompilerProvenance",
      "type": "object"
    },
    "CustomTaskSqlArtifact": {
      "additionalProperties": false,
      "description": "Validated DuckDB query produced by the trusted task compiler.",
      "properties": {
        "contract_version": {
          "const": "v1",
          "title": "Contract Version",
          "type": "string"
        },
        "dataset_id": {
          "const": "rel-hm",
          "title": "Dataset Id",
          "type": "string"
        },
        "dialect": {
          "const": "duckdb",
          "title": "Dialect",
          "type": "string"
        },
        "entity_column": {
          "enum": [
            "customer_id",
            "article_id"
          ],
          "title": "Entity Column",
          "type": "string"
        },
        "entity_table": {
          "enum": [
            "customer",
            "article"
          ],
          "title": "Entity Table",
          "type": "string"
        },
        "horizon_days": {
          "maximum": 7,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "normalized_sql": {
          "minLength": 1,
          "title": "Normalized Sql",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/CompilerProvenance"
        },
        "query_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Query Sha256",
          "type": "string"
        },
        "source": {
          "const": "custom",
          "title": "Source",
          "type": "string"
        },
        "sql": {
          "minLength": 1,
          "title": "Sql",
          "type": "string"
        },
        "target_column": {
          "const": "target",
          "title": "Target Column",
          "type": "string"
        },
        "task_id": {
          "pattern": "^rel-hm/custom/[0-9a-f]{64}$",
          "title": "Task Id",
          "type": "string"
        },
        "task_type": {
          "enum": [
            "binary_classification",
            "regression"
          ],
          "title": "Task Type",
          "type": "string"
        },
        "validation_report": {
          "$ref": "#/$defs/TaskValidationReport"
        }
      },
      "required": [
        "contract_version",
        "dataset_id",
        "task_id",
        "source",
        "dialect",
        "sql",
        "normalized_sql",
        "query_sha256",
        "entity_table",
        "entity_column",
        "target_column",
        "task_type",
        "horizon_days",
        "provenance",
        "validation_report"
      ],
      "title": "CustomTaskSqlArtifact",
      "type": "object"
    },
    "EntitySpec": {
      "additionalProperties": false,
      "properties": {
        "key_column": {
          "minLength": 1,
          "title": "Key Column",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "table",
        "key_column"
      ],
      "title": "EntitySpec",
      "type": "object"
    },
    "HorizonSpec": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "days",
            "weeks",
            "months"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "HorizonSpec",
      "type": "object"
    },
    "LiveDraftReady": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "discriminator": {
            "mapping": {
              "binary_classification": "#/$defs/BinaryTaskContract",
              "regression": "#/$defs/RegressionTaskContract"
            },
            "propertyName": "task_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BinaryTaskContract"
            },
            {
              "$ref": "#/$defs/RegressionTaskContract"
            }
          ],
          "title": "Contract"
        },
        "contract_version": {
          "const": "v1",
          "title": "Contract Version",
          "type": "string"
        },
        "draft_id": {
          "pattern": "^draft_[0-9a-f]{64}$",
          "title": "Draft Id",
          "type": "string"
        },
        "outcome": {
          "const": "draft_ready",
          "title": "Outcome",
          "type": "string"
        },
        "review_required": {
          "const": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "sql_artifact": {
          "$ref": "#/$defs/CustomTaskSqlArtifact"
        },
        "validation_evidence": {
          "discriminator": {
            "mapping": {
              "binary_classification": "#/$defs/BinaryValidationEvidence",
              "regression": "#/$defs/RegressionValidationEvidence"
            },
            "propertyName": "task_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BinaryValidationEvidence"
            },
            {
              "$ref": "#/$defs/RegressionValidationEvidence"
            }
          ],
          "title": "Validation Evidence"
        }
      },
      "required": [
        "contract_version",
        "outcome",
        "draft_id",
        "contract",
        "sql_artifact",
        "validation_evidence",
        "review_required"
      ],
      "title": "LiveDraftReady",
      "type": "object"
    },
    "LiveNeedsClarification": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "v1",
          "title": "Contract Version",
          "type": "string"
        },
        "draft_id": {
          "pattern": "^draft_[0-9a-f]{64}$",
          "title": "Draft Id",
          "type": "string"
        },
        "outcome": {
          "const": "needs_clarification",
          "title": "Outcome",
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/ClarificationQuestion"
          },
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "contract_version",
        "outcome",
        "draft_id",
        "questions"
      ],
      "title": "LiveNeedsClarification",
      "type": "object"
    },
    "PredictionTimeSpec": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "table",
        "column"
      ],
      "title": "PredictionTimeSpec",
      "type": "object"
    },
    "QueryArtifact": {
      "additionalProperties": false,
      "properties": {
        "dialect": {
          "const": "duckdb",
          "title": "Dialect",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "eligibility",
            "label"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "sql": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sql"
        },
        "status": {
          "enum": [
            "generated",
            "not_generated"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "status",
        "dialect",
        "sql"
      ],
      "title": "QueryArtifact",
      "type": "object"
    },
    "RegressionTaskContract": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "draft_id": {
          "minLength": 1,
          "title": "Draft Id",
          "type": "string"
        },
        "eligibility_definition": {
          "minLength": 1,
          "title": "Eligibility Definition",
          "type": "string"
        },
        "entity": {
          "$ref": "#/$defs/EntitySpec"
        },
        "horizon": {
          "$ref": "#/$defs/HorizonSpec"
        },
        "label_definition": {
          "minLength": 1,
          "title": "Label Definition",
          "type": "string"
        },
        "prediction_time": {
          "$ref": "#/$defs/PredictionTimeSpec"
        },
        "query_artifacts": {
          "items": {
            "$ref": "#/$defs/QueryArtifact"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Query Artifacts",
          "type": "array"
        },
        "recommended_metrics": {
          "items": {
            "enum": [
              "mae",
              "r2",
              "rmse"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Recommended Metrics",
          "type": "array"
        },
        "source": {
          "const": "custom",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetSpec"
        },
        "task_type": {
          "const": "regression",
          "title": "Task Type",
          "type": "string"
        }
      },
      "required": [
        "source",
        "draft_id",
        "dataset_id",
        "entity",
        "prediction_time",
        "horizon",
        "target",
        "eligibility_definition",
        "label_definition",
        "query_artifacts",
        "task_type",
        "recommended_metrics"
      ],
      "title": "RegressionTaskContract",
      "type": "object"
    },
    "RegressionValidationEvidence": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Columns",
          "type": "array"
        },
        "null_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Null Rate",
          "type": "number"
        },
        "query_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Query Sha256",
          "type": "string"
        },
        "row_count": {
          "exclusiveMinimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "target_max": {
          "title": "Target Max",
          "type": "number"
        },
        "target_min": {
          "title": "Target Min",
          "type": "number"
        },
        "task_type": {
          "const": "regression",
          "title": "Task Type",
          "type": "string"
        }
      },
      "required": [
        "task_type",
        "query_sha256",
        "columns",
        "row_count",
        "null_rate",
        "target_min",
        "target_max"
      ],
      "title": "RegressionValidationEvidence",
      "type": "object"
    },
    "TargetSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "positive_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positive Class"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "TargetSpec",
      "type": "object"
    },
    "TaskValidationCheck": {
      "additionalProperties": false,
      "description": "One sanitized, machine-readable materialization check.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "status": {
          "const": "passed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "code",
        "status",
        "detail"
      ],
      "title": "TaskValidationCheck",
      "type": "object"
    },
    "TaskValidationReport": {
      "additionalProperties": false,
      "description": "Evidence attached only after every guarded check passes.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/TaskValidationCheck"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "status": {
          "const": "passed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "checks"
      ],
      "title": "TaskValidationReport",
      "type": "object"
    },
    "UnsupportedTaskDraft": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "v1",
          "title": "Contract Version",
          "type": "string"
        },
        "draft_id": {
          "pattern": "^draft_[0-9a-f]{64}$",
          "title": "Draft Id",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "outcome": {
          "const": "unsupported",
          "title": "Outcome",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "unsupported_dataset",
            "unsupported_entity",
            "unsupported_target",
            "unsupported_horizon",
            "unsafe_request"
          ],
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "outcome",
        "draft_id",
        "reason_code",
        "explanation"
      ],
      "title": "UnsupportedTaskDraft",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "draft_ready": "#/$defs/LiveDraftReady",
      "needs_clarification": "#/$defs/LiveNeedsClarification",
      "unsupported": "#/$defs/UnsupportedTaskDraft"
    },
    "propertyName": "outcome"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/LiveNeedsClarification"
    },
    {
      "$ref": "#/$defs/UnsupportedTaskDraft"
    },
    {
      "$ref": "#/$defs/LiveDraftReady"
    }
  ]
}
