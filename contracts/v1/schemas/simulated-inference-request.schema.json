{
  "additionalProperties": false,
  "description": "A no-provider demo request for a reviewed or compiled H&M task.",
  "properties": {
    "contract_version": {
      "const": "v1",
      "title": "Contract Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "rel-hm",
      "title": "Dataset Id",
      "type": "string"
    },
    "task_id": {
      "pattern": "^rel-hm/(?:user-churn|item-sales|custom/[0-9a-f]{64})$",
      "title": "Task Id",
      "type": "string"
    },
    "task_type": {
      "enum": [
        "binary_classification",
        "regression"
      ],
      "title": "Task Type",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "dataset_id",
    "task_id",
    "task_type"
  ],
  "title": "SimulatedInferenceRequest",
  "type": "object"
}
